{
  "expo": {
    "name": "ابر",
    "slug": "aber",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "extra": {
      "supportsRTL": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#48DDB0"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "fa",
        "NSLocationWhenInUseUsageDescription": "ابر برای پیدا کردن سفرها و مکان‌های نزدیک به موقعیت شما نیاز دارد."
      }
    },
    "android": {
      "package": "com.aber.app",
      "adaptiveIcon": {
        "backgroundColor": "#48DDB0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ابر برای پیدا کردن سفرها و مکان‌های نزدیک به موقعیت شما نیاز دارد."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/Vazirmatn-Regular.ttf",
            "./src/assets/fonts/Vazirmatn-Medium.ttf",
            "./src/assets/fonts/Vazirmatn-SemiBold.ttf",
            "./src/assets/fonts/Vazirmatn-Bold.ttf"
          ]
        }
      ]
    ]
  }
}
