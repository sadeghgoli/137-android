{
  "expo": {
    "name": "سبزوار من",
    "slug": "sabzevar-137",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sabzevar137",
    "extra": {
      "router": {
        "origin": "https://test-137.sabzevar.ir",
        "headOrigin": "https://test-137.sabzevar.ir"
      },
      "supportsRTL": true,
      "apiBaseUrl": "https://apiweb-137request.sabzevar.ir",
      "ssoWebUrl": "https://auth.sabzevar.ir",
      "ssoApiUrl": "https://apiweb-loginsso.sabzevar.ir",
      "apiKey": "dev-internal-key-137",
      "requestChannel": "CitizenMobileApp",
      "eas": {
        "projectId": "4f161ade-3b41-42d8-b05e-1d155c09efd6"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#48DDB0"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "fa",
        "NSLocationWhenInUseUsageDescription": "سامانه ۱۳۷ سبزوار برای ثبت موقعیت درخواست به دسترسی مکان نیاز دارد.",
        "NSPhotoLibraryUsageDescription": "برای پیوست تصویر به درخواست به گالری دسترسی لازم است."
      }
    },
    "android": {
      "package": "com.sabzevar137.app",
      "versionCode": 2,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#48DDB0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "سامانه ۱۳۷ سبزوار برای ثبت موقعیت درخواست به دسترسی مکان نیاز دارد."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "برای پیوست تصویر به درخواست به گالری دسترسی لازم است."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./src/assets/fonts/Vazirmatn-Regular.ttf",
            "./src/assets/fonts/Vazirmatn-Medium.ttf",
            "./src/assets/fonts/Vazirmatn-SemiBold.ttf",
            "./src/assets/fonts/Vazirmatn-Bold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@maplibre/maplibre-react-native"
    ],
    "owner": "msadegh.goli"
  }
}
